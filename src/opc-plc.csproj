<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>opcplc</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.IoTEdge.OpcPlc</PackageId>
    <Authors>Microsoft</Authors>
    <Version>1.0.0</Version>
    <RootNamespace>OpcPlc</RootNamespace>
    <UserSecretsId>bdf7b209-fef3-44d4-9aba-17035fda5efd</UserSecretsId>
    <LangVersion>Preview</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Microsoft IoT Edge OPC PLC server</Title>
    <Product>Azure Industrial IoT OPC UA PLC Server</Product>
    <Description>Implements an OPC-UA server with different nodes generating random data, anomalies and configuration of user defined nodes.</Description>
    <RepositoryUrl>https://github.com/Azure-Samples/iot-edge-opc-plc</RepositoryUrl>
    <PackageOutputPath>$(OutputPath)</PackageOutputPath>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>
  <PropertyGroup>
    <ContainerRepository>iotedge/opc-plc</ContainerRepository>
    <ContainerUser>root</ContainerUser>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-azurelinux3.0-distroless</ContainerBaseImage>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="opc-plc-tests" />
    <ContainerEnvironmentVariable Include="APP_UID" Value="" />
    <ContainerEnvironmentVariable Include="DOTNET_ReadyToRun" Value="0" />
    <ContainerEnvironmentVariable Include="DOTNET_TieredPGO" Value="1" />
    <ContainerEnvironmentVariable Include="DOTNET_TC_QuickJitForLoops" Value="1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Mono.Options" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.Extensions.Logging.File" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration$(OpcUaPackageSuffix)" NoWarn="NU5104" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server$(OpcUaPackageSuffix)" NoWarn="NU5104" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Core$(OpcUaPackageSuffix)" NoWarn="NU5104" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Types$(OpcUaPackageSuffix)" NoWarn="NU5104" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Boilers\**\*.Classes.cs;Boilers\**\*.Constants.cs;Boilers\**\*.DataTypes.cs" />
    <Compile Remove="CompanionSpecs\**\*.Classes.cs;CompanionSpecs\**\*.Constants.cs;CompanionSpecs\**\*.DataTypes.cs" />
    <Compile Remove="SimpleEvent\*.Classes.cs;SimpleEvent\*.Constants.cs;SimpleEvent\*.DataTypes.cs" />
  </ItemGroup>

  <ItemGroup>
    <_PlcRuntimeAsset Include="Boilers\Boiler1\BoilerModel1.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="Boilers\Boiler2\BoilerModel2.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="CompanionSpecs\DI\Opc.Ua.DI.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="CompanionSpecs\IA\Opc.Ua.IA.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="CompanionSpecs\Machinery\Opc.Ua.Machinery.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="CompanionSpecs\Pumps\Opc.Ua.Pumps.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="CompanionSpecs\WotCon\Opc.Ua.WotCon.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="SimpleEvent\SimpleEvents.NodeSet2.xml" />
    <_PlcRuntimeAsset Include="wwwroot\stacklight.html" />
    <_PlcRuntimeAsset Include="nodesfile.json" />
    <None Update="@(_PlcRuntimeAsset)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="true"
          PackagePath="contentFiles/%(Identity)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="AlarmCondition\UnderlyingSystem\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Microsoft.IoTEdge.OpcPlc.targets" PackagePath="build/Microsoft.IoTEdge.OpcPlc.targets" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
